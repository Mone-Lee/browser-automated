{
  "name": "browser-automated",
  "version": "1.0.0",
  "description": "浏览器自动化，支持 e2e 测试、e2e 测试用例生成、浏览器自动化操作",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "browser-opt": "dist/cli/browser-opt.js",
    "browser-e2e": "dist/cli/browser-e2e.js",
    "browser-automated": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mone-Lee/browser-automated.git"
  },
  "keywords": [
    "browser",
    "automation",
    "e2e",
    "testing",
    "natural-language",
    "agent",
    "headless"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mone-Lee/browser-automated/issues"
  },
  "homepage": "https://github.com/Mone-Lee/browser-automated#readme",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "agent-browser": "^0.33.1"
  }
}
