{
  "name": "browser-automated",
  "private": true,
  "version": "1.0.0",
  "description": "browser-opt 与 browser-e2e 的 monorepo 工作区",
  "type": "module",
  "workspaces": [
    "packages/browser-core",
    "packages/browser-opt",
    "packages/browser-e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run build --workspaces && vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run build -w @browser-automated/browser-core && npm run typecheck --workspaces",
    "release:check": "node scripts/release-check.mjs",
    "release:dry-run": "node scripts/release.mjs --dry-run",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mone-Lee/browser-automated.git"
  },
  "keywords": [
    "browser",
    "automation",
    "e2e",
    "testing",
    "natural-language",
    "agent",
    "headless"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mone-Lee/browser-automated/issues"
  },
  "homepage": "https://github.com/Mone-Lee/browser-automated#readme",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
