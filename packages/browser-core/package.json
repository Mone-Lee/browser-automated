{
  "name": "@browser-automated/browser-core",
  "version": "1.0.0",
  "description": "browser-opt 与 browser-e2e 共享的浏览器适配与基础类型",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./agent": {
      "import": "./dist/agent.js",
      "types": "./dist/agent.d.ts"
    },
    "./browser-executable": {
      "import": "./dist/browser-executable.js",
      "types": "./dist/browser-executable.d.ts"
    },
    "./proxy-env": {
      "import": "./dist/proxy-env.js",
      "types": "./dist/proxy-env.d.ts"
    },
    "./skill-install": {
      "import": "./dist/skill-install.js",
      "types": "./dist/skill-install.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
