{
  "name": "browser-opt",
  "version": "1.0.6",
  "description": "带证据报告的自然语言浏览器工作流 CLI",
  "type": "module",
  "main": "dist/browser-opt/index.js",
  "types": "dist/browser-opt/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/browser-opt/index.js",
      "types": "./dist/browser-opt/index.d.ts"
    }
  },
  "imports": {
    "#browser-core": {
      "types": "./dist/browser-core/index.d.ts",
      "default": "./dist/browser-core/index.js"
    },
    "#browser-core/*": {
      "types": "./dist/browser-core/*.d.ts",
      "default": "./dist/browser-core/*.js"
    }
  },
  "bin": {
    "browser-opt": "dist/cli/browser-opt.js"
  },
  "files": [
    "dist",
    "skills/browser-opt"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs browser-opt",
    "typecheck": "node ../../scripts/build-package.mjs browser-opt --typecheck"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "agent-browser": "^0.33.1"
  },
  "peerDependenciesMeta": {
    "agent-browser": {
      "optional": true
    }
  }
}
